# Your Nextcloud server root (no trailing /remote.php needed)
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USER=keith
# Settings > Security > Devices & sessions > "Create new app password"
NEXTCLOUD_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# Display name of the list in the Tasks app
LIST_NAME=Shopping
# Your predefined tags, comma-separated, spelled exactly as you want them to appear
# If a tag contains a comma, set TAGS_SEPARATOR=| and separate tags with | instead
TAGS=Fruit & Veg,Meat & Fish,Dairy,Bakery,Frozen,Pantry,Drinks,Household,Toiletries,Baby

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# Optional family-specific rules for the AI
PROMPT_HINTS=Ftira and pastizzi go in Bakery. Anything for the dog goes in Household.

POLL_INTERVAL=60
# Set true for the first run to see what it would do without changing anything
DRY_RUN=true
LOG_LEVEL=INFO
